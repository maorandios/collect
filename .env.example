# Public Supabase (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose to the client. Import only via src/lib/supabase/secret.ts
SUPABASE_SECRET_KEY=

# Canonical app origin for email links and OAuth callbacks (no trailing slash).
# Local Next.js: http://localhost:3000
APP_URL=http://localhost:3000

# HMAC secret for recipient magic links
MAGIC_LINK_SECRET=

# Shared secret for POST /api/cron/tick
CRON_SECRET=

# Local-only short schedules/reminders (minutes). Ignored when NODE_ENV=production.
ENABLE_DEV_SCHEDULES=true

# Supabase Vault (hosted project only):
# - cron_secret: same value as CRON_SECRET
# - app_url: the public Vercel URL in production. Never http://localhost:3000
#   because pg_cron runs inside Supabase and cannot reach your laptop.
# Local development: call POST /api/cron/tick manually with
#   Authorization: Bearer $CRON_SECRET
# Use a public tunnel only if hosted cron must hit a local server.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_SETUP_MODEL=gpt-5.6-luna
OPENAI_SETUP_REASONING_EFFORT=none
OPENAI_SETUP_FALLBACK_MODEL=gpt-5.6-terra

# Nylas (Gmail). Server-only. Never expose to the client or commit secrets.
NYLAS_API_KEY=
NYLAS_CLIENT_ID=
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_CALLBACK_URI=http://localhost:3000/api/nylas/callback

# Auth email (Supabase Custom SMTP via Resend):
# Used only for Collect OTP / Auth messages.
# Workflow emails and reminders are sent later through the customer's Gmail via Nylas.

# Supabase Auth setup for this POC (dashboard, not migrations):
# 1. Authentication → Sign In / Providers → Email
#    - Confirm email: OFF
#    so the first signInWithOtp sends the Magic Link/OTP template, not Confirm signup.
# 2. Authentication → Email Templates — replace BOTH of these.
#    Remove every {{ .ConfirmationURL }}. Use only {{ .Token }}.
#    Paste supabase/auth/otp-email.html into:
#      - Confirm sign up
#      - Magic link
#    Subject for both: קוד הכניסה לקולקט: {{ .Token }}
# 3. Email template for Auth is {{ .Token }} (6 digits). Never a Confirm/Sign in link.
